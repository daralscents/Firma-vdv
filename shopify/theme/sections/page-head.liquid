<section class="page-head">
  <div class="container">
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Paginakop",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Titel" },
    { "type": "richtext", "id": "text", "label": "Tekst" }
  ],
  "presets": [{ "name": "Paginakop" }]
}
{% endschema %}
