{%- paginate search.results by 24 -%}
<section class="page-head">
  <div class="container">
    <h1>{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;max-width:620px;margin-top:16px">
      <input type="hidden" name="type" value="product">
      <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <button class="btn btn--primary" type="submit">{{ 'general.search' | t }}</button>
    </form>
  </div>
</section>
<section class="section">
  <div class="container">
    {%- if search.performed -%}
      <p class="toolbar">{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="products">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <a class="card" href="{{ item.url }}"><h3>{{ item.title }}</h3><p>{{ item.content | strip_html | truncatewords: 20 }}</p></a>
          {%- endif -%}
        {%- else -%}
          <div class="empty" style="grid-column:1/-1"><h3>{{ 'search.no_results' | t }}</h3><p><a href="/pages/contact">{{ 'collections.empty_cta' | t }}</a></p></div>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Zoekresultaten", "settings": [] }
{% endschema %}
