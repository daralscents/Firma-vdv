<section class="section section--tight-top" style="padding-top:{{ section.settings.padding_top }}px">
  <div class="container">
    <div class="cta">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}<a class="btn btn--dark" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call-to-action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Klaar voor uw project?" },
    { "type": "text", "id": "text", "label": "Tekst", "default": "Stuur uw tekening of idee en ontvang een vrijblijvende offerte." },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Neem contact op" },
    { "type": "url", "id": "button_link", "label": "Knoplink" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 80, "step": 8, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Call-to-action" }]
}
{% endschema %}
