<section class="page-head">
  <div class="container"><h1>{{ 'cart.title' | t }}</h1></div>
</section>
<section class="section">
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        <table class="cart-table">
          <thead><tr><th colspan="2">{{ 'cart.product' | t }}</th><th>{{ 'cart.quantity' | t }}</th><th>{{ 'cart.total' | t }}</th></tr></thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>{%- if item.image -%}{{ item.image | image_url: width: 150 | image_tag: loading: 'lazy' }}{%- endif -%}</td>
                <td><a href="{{ item.url }}">{{ item.product.title }}</a>{% unless item.product.has_only_default_variant %}<br><small>{{ item.variant.title }}</small>{% endunless %}</td>
                <td><input class="input" type="number" min="0" name="updates[]" value="{{ item.quantity }}" aria-label="{{ 'cart.quantity' | t }}"></td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        <div class="cart-summary">
          <strong>{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</strong>
          <button class="btn btn--outline" type="submit" name="update">{{ 'cart.update' | t }}</button>
          <button class="btn btn--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>
      </form>
    {%- else -%}
      <div class="empty">
        <h3>{{ 'cart.empty' | t }}</h3>
        <p><a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'collections.catalog' | t }}</a></p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Winkelwagen", "settings": [] }
{% endschema %}
