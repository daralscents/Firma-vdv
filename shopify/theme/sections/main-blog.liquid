{%- paginate blog.articles by 12 -%}
<section class="page-head"><div class="container"><h1>{{ blog.title }}</h1></div></section>
<section class="section">
  <div class="container grid grid--3">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        {%- if article.image -%}<div class="media-box" style="margin-bottom:16px">{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy' }}</div>{%- endif -%}
        <span class="label">{{ article.published_at | date: '%d-%m-%Y' }}</span>
        <h3>{{ article.title }}</h3>
        <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
      </a>
    {%- else -%}
      <p class="empty">{{ 'blog.empty' | t }}</p>
    {%- endfor -%}
  </div>
  <div class="container">{% render 'pagination', paginate: paginate %}</div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
