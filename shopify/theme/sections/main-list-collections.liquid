<section class="page-head">
  <div class="container"><h1>{{ section.settings.heading }}</h1></div>
</section>
<section class="section">
  <div class="container grid grid--3">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' or c.products_count == 0 -%}
        <a class="card" href="{{ c.url }}">
          <div class="card__icon">{% render 'type-icon', type: c.title %}</div>
          <h3>{{ c.title }}</h3>
          <p>{{ c.description | strip_html | truncatewords: 20 }}</p>
          <span class="card__more">{{ 'collections.product_count' | t: count: c.products_count }} →</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collectie-overzicht",
  "settings": [{ "type": "text", "id": "heading", "label": "Kop", "default": "Vakgebieden" }]
}
{% endschema %}
