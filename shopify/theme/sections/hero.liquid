<section class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">{{ section.settings.image | image_url: width: 2000 | image_tag: widths: '750,1100,1500,2000', sizes: '100vw', alt: section.settings.image.alt, fetchpriority: 'high' }}</div>
  {%- endif -%}
  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="btns">
      {%- if section.settings.button_1_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.button_1_link }}">{{ section.settings.button_1_label }}</a>{%- endif -%}
      {%- if section.settings.button_2_label != blank -%}<a class="btn btn--outline-light" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Achtergrondfoto" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Zoetermeer · Plaatwerk & constructie" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Metaal op maat, vakkundig gemaakt" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Wij ontwikkelen en vervaardigen maatwerk in roestvrij staal en metaal: van spoeltafels en afzuigkappen voor de horeca tot machines voor de industrie en exclusieve designobjecten.</p>" },
    { "type": "text", "id": "button_1_label", "label": "Knop 1 tekst", "default": "Bekijk de catalogus" },
    { "type": "url", "id": "button_1_link", "label": "Knop 1 link", "default": "/collections/all" },
    { "type": "text", "id": "button_2_label", "label": "Knop 2 tekst", "default": "Offerte aanvragen" },
    { "type": "url", "id": "button_2_link", "label": "Knop 2 link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
