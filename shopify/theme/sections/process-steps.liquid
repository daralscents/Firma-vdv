<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}">
  <div class="container">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        <div class="card" {{ block.shopify_attributes }}>
          <div class="card__icon">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Werkwijze (stappen)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "default": "Zo werken wij" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "checkbox", "id": "alt_bg", "label": "Grijze achtergrond", "default": true }
  ],
  "blocks": [
    { "type": "step", "name": "Stap", "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Stap" },
      { "type": "textarea", "id": "text", "label": "Tekst" }
    ] }
  ],
  "presets": [{ "name": "Werkwijze (stappen)", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
